{
  "name": "playwrightautomation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test tests/WebAPIPart1.spec.js --headed",
    "regression": "npx playwright test",
    "webTests": "npx playwright test --grep \"@Web\"",
    "APITest": "npx playwright test --grep \"@API\"",
    "SafariNewConfig": "npx playwright test --config playwright.config1.js --project=safari",
    "playwright-allure-reporter-webTests": "npx playwright test --grep \"@Web\" --reporter=line,allure-playwright",
    "allure-generate": "allure generate .\\allure-results --clean",
    "allure-openreport": "allure open ./allure-report",
    "CucumberRegression": "npx cucumber-js --tags \"@Regression\" --retry 1 --exit --format html:cucumber-report.html "
  },
  "keywords": [],
  "author": "",
